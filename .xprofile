#!/bin/sh

# .xprofile - executed by display managers (GDM, LightDM, SDDM)

# Configure monitors: DP-2 (left), HDMI-0 (middle), DP-0 (right)
LOGFILE=/tmp/xprofile-xrandr.log
echo "=== xprofile xrandr debug $(date) ===" > $LOGFILE
echo "DISPLAY=$DISPLAY" >> $LOGFILE

# Wait for X server to be ready
MAX_WAIT=15
WAITED=0
echo "Waiting for X server..." >> $LOGFILE
while [ $WAITED -lt $MAX_WAIT ]; do
    if xrandr >/dev/null 2>&1; then
        echo "X server ready after ${WAITED}s" >> $LOGFILE
        break
    fi
    echo "X server not ready (waited ${WAITED}s)" >> $LOGFILE
    sleep 1
    WAITED=$((WAITED + 1))
done

# Wait for all displays to be detected
DISPLAYS="DP-2 HDMI-0 DP-0"
MAX_WAIT=10
WAITED=0

echo "Waiting for displays..." >> $LOGFILE
xrandr >> $LOGFILE 2>&1
while [ $WAITED -lt $MAX_WAIT ]; do
    ALL_CONNECTED=true
    for DISPLAY_NAME in $DISPLAYS; do
        if ! xrandr | grep -q "^$DISPLAY_NAME connected"; then
            ALL_CONNECTED=false
            echo "Display $DISPLAY_NAME not yet connected (waited ${WAITED}s)" >> $LOGFILE
            break
        fi
    done

    if [ "$ALL_CONNECTED" = "true" ]; then
        echo "All displays connected after ${WAITED}s" >> $LOGFILE
        break
    fi

    sleep 1
    WAITED=$((WAITED + 1))
done

echo "Running xrandr command..." >> $LOGFILE
xrandr --output DP-2 --auto --mode 2560x1440 --pos 0x0 \
       --output HDMI-0 --auto --mode 2560x1440 --pos 2560x0 \
       --output DP-0 --auto --mode 2560x1440 --pos 5120x0 --primary >> $LOGFILE 2>&1
echo "xrandr exit code: $?" >> $LOGFILE

# Disable screensaver and monitor power management (keep monitors always on)
xset s off          # Disable screensaver
xset s noblank      # Don't blank the screen
xset -dpms          # Disable DPMS (Display Power Management Signaling)
